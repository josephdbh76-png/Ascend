# ── Supabase ──────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (TEST MODE ONLY for the beta) ─────────────────────────────
# Secret key from a TEST mode Stripe account (starts with sk_test_).
STRIPE_SECRET_KEY=
# OAuth client id of a Connect "Standard" platform, in test mode
# (starts with ca_). Required only for the "Connect Stripe" flow.
# https://dashboard.stripe.com/test/settings/connect/onboarding-options
STRIPE_CLIENT_ID=
# Signing secret for Stripe webhooks, if/when webhooks are added.
STRIPE_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────
# Public URL this app is served from (used for OAuth redirects, emails,
# OG metadata). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Analytics (optional) ────────────────────────────────────────────
# The app runs fine with these unset — analytics calls become no-ops.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
